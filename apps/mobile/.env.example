# Where the app reaches the API and the website. Leave these out in
# development: the app uses the computer Expo is running on. Set them for
# real builds.
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_SITE_URL=https://www.example.com
# Razorpay Key ID (public by design; the secret stays on the API).
EXPO_PUBLIC_RAZORPAY_KEY_ID=
# Courses go on sale when this is true (videos must be on Cloudflare Stream).
EXPO_PUBLIC_COURSES_LIVE=false
