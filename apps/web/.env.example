NEXT_PUBLIC_API_URL=http://localhost:4000

# Razorpay's publishable key id, used to open the checkout widget. This one is
# meant to be public — it identifies the merchant and nothing more.
#
# The key SECRET and the webhook secret must never appear here or in any other
# NEXT_PUBLIC_* variable: anything with that prefix is compiled into the
# JavaScript bundle served to every visitor. They belong in apps/api/.env only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# The Google OAuth client ID, same value as GOOGLE_CLIENT_ID in apps/api/.env.
# Public by design — it identifies the application to Google and nothing more.
# The client SECRET is never needed by this flow and must not appear here.
#
# Leave blank and the "Continue with Google" button is simply not rendered;
# OTP sign-in carries on working.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The site's public origin, used to build the URL a certificate's QR code
# points at. Certificates get printed and handed to employers, so this has to
# be the real deployed origin — a QR with "localhost" inside it is worthless
# the moment the certificate leaves the machine that generated it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines: set to "true" on the production deployment only. Anywhere
# else — staging, previews, local — robots.txt blocks all crawling, so a
# second copy of the site never competes with the real one in search results.
ALLOW_SEARCH_INDEXING=

# Optional. Where the web server reaches the API when rendering pages, if that
# differs from NEXT_PUBLIC_API_URL (e.g. a private network address inside the
# deployment). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# ── The business's own details ─────────────────────────────────────────────
# Printed on the Terms, Privacy, Refund, Delivery and Contact pages. None is
# secret. While any is blank, those pages show a highlighted placeholder for
# it and a "Draft — pending legal review" banner. Fill them in, and have the
# pages read by the client's lawyer, before applying for Razorpay activation.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_GSTIN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
NEXT_PUBLIC_JURISDICTION_CITY=
# As the lawyer signs the pages off, e.g. "1 November 2026".
NEXT_PUBLIC_POLICIES_UPDATED_ON=

# Error monitoring (Sentry). Leave blank to keep it off — nothing is sent.
# The website's own project DSN; public by design (it only lets someone send
# reports, not read them). The API has its own SENTRY_DSN in apps/api/.env.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Courses are built but wait on video hosting (Cloudflare Stream). Until this
# is "true", /courses and every course page show "coming soon" and nothing
# course-related can be bought. Anyone already enrolled keeps My courses.
NEXT_PUBLIC_COURSES_LIVE=false
