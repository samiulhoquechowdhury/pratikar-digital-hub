NEXT_PUBLIC_API_URL=http://localhost:4000

# Razorpay's publishable key id, used to open the checkout widget. This one is
# meant to be public — it identifies the merchant and nothing more.
#
# The key SECRET and the webhook secret must never appear here or in any other
# NEXT_PUBLIC_* variable: anything with that prefix is compiled into the
# JavaScript bundle served to every visitor. They belong in apps/api/.env only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
