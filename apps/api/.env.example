DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pratikar
REDIS_URL=redis://localhost:6379

# Generate real values with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
OTP_HMAC_SECRET=change-me
# Signs short-lived download URLs. Anyone who knows it can mint a link to any
# object in the bucket, so treat it like the JWT secret. Rotating it
# invalidates outstanding download links, which is the intended behaviour.
STORAGE_URL_SECRET=change-me

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Invent this one yourself (openssl rand -hex 24) and paste the same value
# into the Razorpay dashboard when creating the webhook — Razorpay does not
# issue it. Signature verification fails closed if it is unset.
RAZORPAY_WEBHOOK_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
MSG91_API_KEY=

# "Sign in with Google". This is the OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application) — the
# same value the web app puts in NEXT_PUBLIC_GOOGLE_CLIENT_ID. It is public by
# design; the client SECRET is not used by this flow and should not be added.
#
# The API verifies that every Google token names this ID as its audience, so
# leaving it blank disables Google sign-in rather than weakening it. Comma-
# separate to accept more than one (the Android app gets its own ID).
GOOGLE_CLIENT_ID=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000

# The first admin account. OTP signup always creates a CUSTOMER and only a
# SUPER_ADMIN can change roles, so without this a fresh deployment has nobody
# who can reach the admin panel. Read by `pnpm seed`.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
