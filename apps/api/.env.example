DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pratikar
REDIS_URL=redis://localhost:6379

# Generate real values with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
OTP_HMAC_SECRET=change-me
# Signs short-lived download URLs. Anyone who knows it can mint a link to any
# object in the bucket, so treat it like the JWT secret. Rotating it
# invalidates outstanding download links, which is the intended behaviour.
STORAGE_URL_SECRET=change-me

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Invent this one yourself (openssl rand -hex 24) and paste the same value
# into the Razorpay dashboard when creating the webhook — Razorpay does not
# issue it. Signature verification fails closed if it is unset.
RAZORPAY_WEBHOOK_SECRET=

R2_ACCOUNT_ID=
# Named as Cloudflare's dashboard names them, so credentials can be copied
# across without renaming. R2_ACCESS_KEY / R2_SECRET_KEY are still read.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
MSG91_API_KEY=

# "Sign in with Google". This is the OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application) — the
# same value the web app puts in NEXT_PUBLIC_GOOGLE_CLIENT_ID. It is public by
# design; the client SECRET is not used by this flow and should not be added.
#
# The API verifies that every Google token names this ID as its audience, so
# leaving it blank disables Google sign-in rather than weakening it. Comma-
# separate to accept more than one (the Android app gets its own ID).
GOOGLE_CLIENT_ID=

# Embeddings for the chatbot's knowledge base (docs/trd.md 4.6). Without a key
# the index stays empty and nothing else is affected — saves still succeed, the
# worker just logs a skip. After setting it (or changing the model), run
# POST /ai/knowledge-base/reindex once to fill the index.
#
# Until a payment method is added in Voyage's billing page the account is
# limited to 3 requests a minute. That works — the worker pauses the queue on
# a 429 and resumes — but a full reindex then runs at 3 items a minute.
VOYAGE_API_KEY=
# Must produce 1024 dimensions — the column is vector(1024). voyage-4,
# voyage-4-lite and voyage-4-large all do.
VOYAGE_EMBEDDING_MODEL=voyage-4

# The site assistant (POST /ai/chat). Needs VOYAGE_API_KEY too — answers are
# grounded in the knowledge base. Without either key the endpoint answers
# 503 AI_NOT_CONFIGURED and the website falls back to its scripted preview.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when blank. Run at low effort; see
# apps/api/src/modules/ai/chat/chat.service.ts.
ANTHROPIC_MODEL=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000

# How many proxies sit in front of the API. Every per-IP rate limit (OTP,
# chat) counts by client IP, and behind a proxy the API only sees the real
# one if it trusts the proxy's X-Forwarded-For. Leave blank locally. On
# Railway set it to the number of proxy hops — confirm by logging req.ip from
# a known address first. Too high lets clients forge their IP; the API refuses
# to start on anything but 0-5.
TRUST_PROXY_HOPS=

# The first admin account. OTP signup always creates a CUSTOMER and only a
# SUPER_ADMIN can change roles, so without this a fresh deployment has nobody
# who can reach the admin panel. Read by `pnpm seed`.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ── GST invoicing ────────────────────────────────────────────────────────────
# Printed on every invoice, so none of it is secret — but it is deployment
# specific, and it is the difference between a tax invoice and a piece of
# paper. Leave these blank and the system still records and numbers every
# sale correctly; the PDFs are just watermarked PROFORMA and are not valid
# tax invoices. Fill them in before taking real money.
#
# COMPANY_STATE_CODE must match the first two digits of COMPANY_GSTIN — the
# API refuses the configuration outright if they disagree, because that
# mismatch would put the wrong CGST/SGST/IGST split on every invoice issued.
COMPANY_LEGAL_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE_CODE=

# Prefixes the invoice serial, e.g. PDH/2627/000001. Rule 46(b) caps the whole
# number at 16 characters, so this has to stay short — the API throws at issue
# time rather than minting an invalid number.
INVOICE_NUMBER_PREFIX=PDH

# SAC codes per item type. Defaults are in invoice-config.ts and are a
# developer's best reading, not an accountant's ruling — override them here
# once the client's CA has confirmed the classification.
# INVOICE_SAC_DOCUMENT=998213
# INVOICE_SAC_DOCUMENT_REVIEW=998213
# INVOICE_SAC_CONTENT_ITEM=998439
# INVOICE_SAC_COURSE=999293

# Error monitoring (Sentry). Leave blank to keep it off — nothing is sent.
# What a report may contain is locked down in src/common/monitoring/: no
# request bodies, cookies, headers, query strings or captured variables.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Links in emails. The customer website, and the admin panel for staff
# alerts. Locally the website is :3000 and the admin :3001.
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001

# Who gets staff alerts — a paid order, a lawyer review requested.
# Comma-separated. Leave empty and no alerts are sent.
STAFF_ALERT_EMAILS=
