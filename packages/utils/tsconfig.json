{
  "extends": "@pratikar/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    // No outDir/declaration: package.json points main and types straight at
    // src, so consumers compile this from source. This config exists for
    // typecheck and for ESLint's type-aware rules, not to emit anything.
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
